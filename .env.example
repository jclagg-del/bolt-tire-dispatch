# Optional: set this when your Quo workspace has multiple business numbers.
# Use E.164 format, for example: +18455551212
NEXT_PUBLIC_QUO_PHONE_NUMBER=

# Quo API (server-only) for automatic post-appointment review texts.
# QUO_PHONE_NUMBER_ID is the PN... identifier returned by Quo's phone-numbers API.
